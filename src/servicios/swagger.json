{
  "swagger": "2.0",
  "info": {
    "description": "API para el portal web de la carrera de Administración de Empresas. Incluye endpoints para gestionar usuarios.",
    "version": "1.0.0",
    "title": "API de Administración de Empresas",
    "contact": {
      "email": "admin@empresa.com"
    }
  },
  "host": "localhost",
  "basePath": "/src/data",
  "schemes": ["http"],
  "paths": {
    "/loginUsuarios": {
      "post": {
        "tags": ["Login"],
        "summary": "Login de usuario",
        "description": "Valida las credenciales del usuario y permite iniciar sesión.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Email y contraseña del usuario.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "emailAdm": { "type": "string", "example": "admin@empresa.com" },
                "password": { "type": "string", "example": "12345" }
              },
              "required": ["emailAdm", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login exitoso",
            "schema": {
              "type": "object",
              "properties": {
                "mensaje": { "type": "string", "example": "Login exitoso" },
                "usuario": { "$ref": "#/definitions/Usuario" }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          },
          "400": {
            "description": "Faltan datos para el login",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      },
      "get": {
        "tags": ["Usuario"],
        "summary": "Obtener información del usuario",
        "description": "Recupera información completa del usuario o solo su rol.",
        "parameters": [
          {
            "name": "emailAdm",
            "in": "query",
            "description": "Email del usuario.",
            "required": true,
            "type": "string"
          },
          {
            "name": "tipo",
            "in": "query",
            "description": "Especifica 'rol' para obtener solo el rol del usuario.",
            "required": false,
            "type": "string",
            "enum": ["rol"]
          }
        ],
        "responses": {
          "200": {
            "description": "Información del usuario",
            "schema": { "$ref": "#/definitions/Usuario" }
          },
          "404": {
            "description": "Usuario no encontrado",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          },
          "400": {
            "description": "Parámetros incorrectos",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      }
    }
  },
  "definitions": {
    "Usuario": {
      "type": "object",
      "properties": {
        "emailAdm": { "type": "string", "example": "admin@empresa.com" },
        "nombre": { "type": "string", "example": "Juan" },
        "apellido": { "type": "string", "example": "Pérez" },
        "celular": { "type": "string", "example": "1234567890" },
        "estado": { "type": "boolean", "example": true },
        "rol": { "type": "string", "example": "Administrador" },
        "fechaRegistro": { "type": "string", "format": "date", "example": "2024-01-01" },
        "emailContacto": { "type": "string", "example": "contacto@empresa.com" }
      }
    }
  }
}
