{
  "swagger": "2.0",
  "info": {
    "description": "API para el portal web de la carrera de Administración de Empresas. Incluye endpoints para gestionar usuarios.",
    "version": "1.0.0",
    "title": "API de Administración de Empresas",
    "contact": {
      "email": "admin@empresa.com"
    }
  },
  "host": "localhost",
  "basePath": "/src/servicios",
  "schemes": ["http"],
  "paths": {
    "/loginUsuarios": {
      "post": {
        "tags": ["Login"],
        "summary": "Login de usuario",
        "description": "Valida las credenciales del usuario y permite iniciar sesión.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Email y contraseña del usuario.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "emailAdm": { "type": "string", "example": "admin@empresa.com" },
                "password": { "type": "string", "example": "12345" }
              },
              "required": ["emailAdm", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login exitoso",
            "schema": {
              "type": "object",
              "properties": {
                "mensaje": { "type": "string", "example": "Login exitoso" },
                "usuario": { "$ref": "#/definitions/Usuario" }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          },
          "400": {
            "description": "Faltan datos para el login",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      },
      "get": {
        "tags": ["Usuario"],
        "summary": "Obtener información del usuario",
        "description": "Recupera información completa del usuario o solo su rol.",
        "parameters": [
          {
            "name": "emailAdm",
            "in": "query",
            "description": "Email del usuario.",
            "required": true,
            "type": "string"
          },
          {
            "name": "tipo",
            "in": "query",
            "description": "Especifica 'rol' para obtener solo el rol del usuario.",
            "required": false,
            "type": "string",
            "enum": ["rol"]
          }
        ],
        "responses": {
          "200": {
            "description": "Información del usuario",
            "schema": { "$ref": "#/definitions/Usuario" }
          },
          "404": {
            "description": "Usuario no encontrado",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          },
          "400": {
            "description": "Parámetros incorrectos",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      }
    },
    "/empresasAPI.php": {
      "get": {
        "tags": ["Empresas"],
        "summary": "Listar empresas o buscar por ID/nombre",
        "description": "Obtiene la lista de empresas. También puede buscar una empresa por ID o nombre.",
        "parameters": [
          {
            "name": "idEmpresa",
            "in": "query",
            "description": "ID de la empresa.",
            "required": false,
            "type": "integer"
          },
          {
            "name": "nombreEmpresa",
            "in": "query",
            "description": "Nombre de la empresa.",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Empresas obtenidas",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Empresa" }
            }
          },
          "404": {
            "description": "Empresa(s) no encontrada(s)",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      },
      "post": {
        "tags": ["Empresas"],
        "summary": "Crear una nueva empresa",
        "description": "Crea una empresa verificando que el nombre de la imagen no se repita.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Información de la nueva empresa.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombreEmpresa": { "type": "string", "example": "Nueva Empresa" },
                "imagenEmpresa": { "type": "string", "example": "logo.jpg" },
                "descripcionEmpresa": { "type": "string", "example": "Descripción de la empresa" }
              },
              "required": ["nombreEmpresa", "imagenEmpresa", "descripcionEmpresa"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Empresa creada exitosamente",
            "schema": {
              "type": "object",
              "properties": {
                "mensaje": { "type": "string", "example": "Empresa creada exitosamente." },
                "idEmpresa": { "type": "integer", "example": 1 }
              }
            }
          },
          "409": {
            "description": "Conflicto: Imagen duplicada",
            "schema": { "type": "object", "properties": { "mensaje": { "type": "string" } } }
          }
        }
      }
    }
  },
  "definitions": {
    "Usuario": {
      "type": "object",
      "properties": {
        "emailAdm": { "type": "string", "example": "admin@empresa.com" },
        "nombre": { "type": "string", "example": "Juan" },
        "apellido": { "type": "string", "example": "Pérez" },
        "celular": { "type": "string", "example": "1234567890" },
        "estado": { "type": "boolean", "example": true },
        "rol": { "type": "string", "example": "Administrador" },
        "fechaRegistro": { "type": "string", "format": "date", "example": "2024-01-01" }
      }
    },
    "Empresa": {
      "type": "object",
      "properties": {
        "idEmpresa": { "type": "integer", "example": 1 },
        "nombreEmpresa": { "type": "string", "example": "Mi Empresa" },
        "imagenEmpresa": { "type": "string", "example": "logo.jpg" },
        "descripcionEmpresa": { "type": "string", "example": "Empresa dedicada a X" }
      }
    }
  }
}